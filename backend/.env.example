# Copy to .env and fill in from console.x.com (see docs/setup-x.md).
X_CLIENT_ID=
# Only for "confidential" apps (Web App type); leave empty for public clients.
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
FRONTEND_URL=http://127.0.0.1:5173
MONTHLY_BUDGET_USD=5
DB_PATH=data.sqlite
